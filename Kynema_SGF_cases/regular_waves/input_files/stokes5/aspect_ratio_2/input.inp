# Generated by generate_cases.py; see case.json for sweep and sampling metadata.
# CFL is an orbital-velocity planning estimate; verify actual CFL in solver logs.
time.stop_time = 192
time.max_step = -1
time.initial_dt = 0.01071638649738078
time.fixed_dt = 0.01071638649738078
time.cfl = 0.5
time.use_force_cfl = false
time.plot_interval = -1
time.checkpoint_interval = -1

incflo.use_godunov = 1
incflo.godunov_type = "weno_z"
incflo.diffusione_type = 0
transport.model = TwoPhaseTransport
transport.viscosity_fluid1 = 0.0
transport.viscosity_fluid2 = 0.0
transport.laminar_prandtl = 0.7
transport.turbulent_prandtl = 0.3333
turbulence.model = Laminar
incflo.physics = MultiPhase OceanWaves
incflo.gravity = 0 0 -9.81
MultiPhase.density_fluid1 = 1000.
MultiPhase.density_fluid2 = 1.
MultiPhase.verbose = 0
ICNS.source_terms = GravityForcing
ICNS.use_perturb_pressure = true
nodal_proj.bottom_atol = 1e-14
mac_proj.bottom_atol = 1e-14

OceanWaves.label = Wave1
OceanWaves.Wave1.type = StokesWaves
OceanWaves.Wave1.order = 5
OceanWaves.Wave1.wave_height = 0.3585
OceanWaves.Wave1.wave_length = 4
OceanWaves.Wave1.water_depth = 4
OceanWaves.Wave1.zero_sea_level = 0.
OceanWaves.Wave1.wave_phase_offset_radians = 0.
OceanWaves.Wave1.relax_zone_gen_length = 4.
OceanWaves.Wave1.numerical_beach_length = 8.
OceanWaves.Wave1.numerical_beach_length_factor = 1.
OceanWaves.Wave1.initialize_wave_field = false
OceanWaves.Wave1.timeramp_period = 3.2

geometry.prob_lo = 0 -0.3 -4
geometry.prob_hi = 48 0.3 2
geometry.is_periodic = 0 1 0
xlo.type = "wave_generation"
xhi.type = "pressure_outflow"
zlo.type = "no_slip_wall"
zhi.type = "no_slip_wall"

amr.n_cell = 160 2 40
amr.max_level = 2
amr.ref_ratio = 2 2
amr.blocking_factor_x = 8
amr.blocking_factor_y = 2
amr.blocking_factor_z = 2
amr.regrid_int = -1
tagging.labels = static
tagging.static.type = CartBoxRefinement
tagging.static.static_refinement_def = static_box.txt

incflo.post_processing = sampling_fs_domain sampling_fs_target

sampling_fs_domain.output_frequency = 4
sampling_fs_domain.output_format = ascii
sampling_fs_domain.labels = fs_domain
sampling_fs_domain.fields = vof
sampling_fs_domain.fs_domain.type = FreeSurfaceSampler
sampling_fs_domain.fs_domain.phase_field = vof
sampling_fs_domain.fs_domain.plane_num_points = 561 1
sampling_fs_domain.fs_domain.plane_start = 8.0 0.0 0.0
sampling_fs_domain.fs_domain.plane_end = 36.0 0.0 0.0
sampling_fs_domain.fs_domain.max_sample_points_per_cell = 32

sampling_fs_target.output_frequency = 4
sampling_fs_target.output_format = ascii
sampling_fs_target.labels = fs_target
sampling_fs_target.fields = ow_vof
sampling_fs_target.fs_target.type = FreeSurfaceSampler
sampling_fs_target.fs_target.phase_field = ow_vof
sampling_fs_target.fs_target.plane_num_points = 561 1
sampling_fs_target.fs_target.plane_start = 8.0 0.0 0.0
sampling_fs_target.fs_target.plane_end = 36.0 0.0 0.0
sampling_fs_target.fs_target.max_sample_points_per_cell = 32

incflo.verbose = 1
